# --- dough-git configuration -------------------------------------------------
# Copy to `.env` and fill in. Read at startup (see src/config.ts).
# Repo visibility is a filesystem marker plus a collaborator table, git auth is
# per-user tokens minted in the browser, and browser sessions are stateless
# signed cookies over a small SQLite user directory.

# Where your bare repositories live. Each repo is a `<name>.git` directory here.
MINIGIT_REPOS_ROOT=/srv/git

# Public base URL (used for OIDC redirect + the clone URLs shown in the UI).
MINIGIT_BASE_URL=https://backup.doughmination.gay

# HTTP listen host/port (put this behind your reverse proxy / TLS).
MINIGIT_HOST=127.0.0.1
MINIGIT_PORT=4010

# Site title shown in the header.
MINIGIT_TITLE=dough-git

# Directory served at /static. Drop your own style.css here to restyle.
MINIGIT_STATIC_DIR=./public

# Site icon: the favicon, and the image used in link/social previews. Wants to
# be an absolute URL so it resolves off-site too.
MINIGIT_FAVICON=https://m.doughmination.gay/img/avatars/git.png

# Fallback <meta name="description">. Repo pages prefer the repo's own
# `description` file, then the opening prose of its README.
MINIGIT_DESCRIPTION=A minimal self-hosted git mirror.

# Browser UI colour on mobile (<meta name="theme-color">).
MINIGIT_THEME_COLOR=#0a0b10

# Filename that marks a bare repo public. Absent from the repo dir = private.
# Public  = anyone may read, no login needed.
# Private = the owner, plus anyone they add as a collaborator on the repo page.
MINIGIT_PUBLIC_MARKER=minigit-public

# --- git transport auth ------------------------------------------------------
# Users mint their own tokens in the browser at /tokens. There are no instance-
# wide tokens: every token belongs to exactly one account, so the Basic-auth
# USERNAME must be that account's owner slug.
#   git clone https://<username>:<TOKEN>@backup.doughmination.gay/<owner>/repo.git
#
# A token can push to repos under its own <slug>/, and to any repo where its
# account was granted `write` as a collaborator. It can read anything public,
# plus private repos it owns or was granted access to.

# SQLite file for the user directory, browser-managed tokens, and the
# per-repository collaborator grants.
# Defaults to <repos>/dough-git.db.
MINIGIT_DB_PATH=

# Auto-create a bare repo on first authenticated push (set "false" to disable).
# A name held by a repository in Recently Deleted is never auto-created over:
# the push is refused until that copy is restored or purged.
MINIGIT_AUTO_CREATE=true

# --- deletion + recovery -----------------------------------------------------
# Deleting a repository moves it to <repos>/.trash/<owner>/<name>.<ts>.git
# instead of destroying it, and its name stays reserved while it is recoverable.
# Restore or purge it from /settings/deleted.
#
# The trash lives inside MINIGIT_REPOS_ROOT deliberately: same filesystem (so
# the move is atomic), same backup volume, and a leading dot keeps it invisible
# to the repository listing.
#
# How many days a deleted repository stays recoverable. 0 keeps them forever.
# The server sweeps every owner's trash at startup and every six hours after,
# and opening the recovery page also purges that owner's expired copies, so the
# window is enforced whether or not anyone looks.
MINIGIT_TRASH_DAYS=30

# --- notifications and mirror status -----------------------------------------
# Both are configured per account in the web UI at /settings, not here.
#
#   Discord webhook  — announces repositories being created and deleted, and
#                      commits being pushed. Only discord.com (and its
#                      canary/ptb/discordapp hostnames) are accepted. Private
#                      repositories are NOT announced unless you opt in.
#
#   Mirror status    — per repository, you can record where else it is kept on
#                      GitHub and Codeberg. dough-git then reports whether those
#                      copies still exist and whether their refs match, using
#                      `git ls-remote` only. It never pushes, fetches, repairs
#                      or creates anything on a remote, and stores no
#                      credentials for them: a private mirror is marked
#                      `private` in the repo's `dough-links` file and skipped.
#
# This means the server makes outbound HTTPS requests to discord.com,
# github.com and codeberg.org — and, by host allow-list, nowhere else.

# --- PocketID (OIDC) ---------------------------------------------------------
# Only needed to *view private repos in a browser*. Register this callback URL
# in PocketID:  <MINIGIT_BASE_URL>/auth/callback
# OIDC_ISSUER must EXACTLY match the `iss` PocketID puts on the callback (the
# app logs the discovered issuer at boot so you can compare).
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Token-endpoint auth method. Leave blank for the default. Set to "post" if your
# PocketID client uses client_secret_post, or "none" for a public (PKCE-only)
# client with no secret.
OIDC_TOKEN_AUTH=

# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# There is no allow-list. Anyone who can sign in to PocketID can sign in here:
# PocketID is the guest list, and a second one only ever drifts out of step with
# it. Signing in earns a namespace of that person's own — not access to anybody
# else's. Restrict who may log in by restricting the PocketID client instead.
