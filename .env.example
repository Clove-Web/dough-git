# --- minigit configuration ---------------------------------------------------
# Copy to `.env` and fill in. Read at startup (see src/config.ts).
# No database: visibility is a filesystem marker, git auth is tokens below,
# and browser sessions are stateless signed cookies.

# Where your bare repositories live. Each repo is a `<name>.git` directory here.
MINIGIT_REPOS_ROOT=/srv/git

# Public base URL (used for OIDC redirect + the clone URLs shown in the UI).
MINIGIT_BASE_URL=https://backup.doughmination.gay

# HTTP listen host/port (put this behind your reverse proxy / TLS).
MINIGIT_HOST=127.0.0.1
MINIGIT_PORT=4010

# Site title shown in the header.
MINIGIT_TITLE=dough-git

# Directory served at /static. Drop your own style.css here to restyle.
MINIGIT_STATIC_DIR=./public

# Filename that marks a bare repo public. Absent from the repo dir = private.
MINIGIT_PUBLIC_MARKER=minigit-public

# --- git transport auth ------------------------------------------------------
# Comma-separated tokens accepted as the HTTP Basic *password* for
# clone / pull / push. Any username works. Generate each with:
#   openssl rand -hex 24
# Clone example:
#   git clone https://x-token:<TOKEN>@git.example.com/myrepo.git
MINIGIT_GIT_TOKENS=

# --- PocketID (OIDC) ---------------------------------------------------------
# Only needed to *view private repos in a browser*. Register this callback URL
# in PocketID:  <MINIGIT_BASE_URL>/auth/callback
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Comma-separated OIDC `sub` values (or emails) allowed to log in.
# Leave blank to allow any successful PocketID login. Set to your own account
# so randoms can't get in.
ALLOWED_USERS=
