{
  "name": "dough-git",
  "version": "0.1.0",
  "description": "A minimal self-hosted git mirror: HTTP clone/pull/push + cgit-style viewer, gated by PocketID (OIDC). Styled with Vanilla Extract.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning dist/server.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types test/transport.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.13.1",
    "openid-client": "^6.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vanilla-extract/css": "^1.17.0",
    "@vanilla-extract/esbuild-plugin": "^2.3.11",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
